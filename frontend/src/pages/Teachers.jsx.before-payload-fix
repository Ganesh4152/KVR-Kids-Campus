import { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";

const API_BASE = "http://localhost:8080/api";

const emptyTeacher = {
  employeeId: "",
  firstName: "",
  lastName: "",
  fullName: "",
  gender: "",
  dateOfBirth: "",
  qualification: "",
  specialization: "",
  mobile: "",
  email: "",
  addressLine1: "",
  joiningDate: "",
  designation: "",
  department: "",
  experienceYears: "",
  salary: "",
  status: "ACTIVE",
};

function Teachers() {
  const navigate = useNavigate();

  const [teachers, setTeachers] = useState([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  const [showModal, setShowModal] = useState(false);
  const [editingId, setEditingId] = useState(null);

  const [form, setForm] = useState(emptyTeacher);

  // =========================================================
  // LOAD TEACHERS
  // =========================================================

  const loadTeachers = async () => {
    try {
      setLoading(true);
      setError("");

      const response = await fetch(`${API_BASE}/teachers`);

      if (!response.ok) {
        throw new Error(
          `Unable to load teachers (${response.status})`
        );
      }

      const data = await response.json();

      setTeachers(Array.isArray(data) ? data : []);

    } catch (err) {
      console.error("Load teachers error:", err);
      setError(
        err.message || "Unable to load teachers."
      );
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadTeachers();
  }, []);

  // =========================================================
  // FORM
  // =========================================================

  const handleChange = (event) => {
    const { name, value } = event.target;

    setForm((previous) => ({
      ...previous,
      [name]: value,
    }));
  };

  const openAddModal = () => {
    setEditingId(null);
    setForm(emptyTeacher);
    setError("");
    setSuccess("");
    setShowModal(true);
  };

  const openEditModal = (teacher) => {
    setEditingId(teacher.id);

    setForm({
      employeeId: teacher.employeeId || "",
      firstName: teacher.firstName || "",
      lastName: teacher.lastName || "",
      fullName: teacher.fullName || "",
      gender: teacher.gender || "",
      dateOfBirth: teacher.dateOfBirth
        ? teacher.dateOfBirth.substring(0, 10)
        : "",
      qualification: teacher.qualification || "",
      specialization: teacher.specialization || "",
      mobile: teacher.mobile || "",
      email: teacher.email || "",
      addressLine1: teacher.addressLine1 || "",
      joiningDate: teacher.joiningDate
        ? teacher.joiningDate.substring(0, 10)
        : "",
      designation: teacher.designation || "",
      department: teacher.department || "",
      experienceYears: teacher.experienceYears || "",
      salary:
        teacher.salary !== null &&
        teacher.salary !== undefined
          ? teacher.salary
          : "",
      status: teacher.status || "ACTIVE",
    });

    setError("");
    setSuccess("");
    setShowModal(true);
  };

  const closeModal = () => {
    if (saving) {
      return;
    }

    setShowModal(false);
    setEditingId(null);
    setForm(emptyTeacher);
  };

  // =========================================================
  // SAVE
  // =========================================================

  const saveTeacher = async (event) => {
    event.preventDefault();

    setSaving(true);
    setError("");
    setSuccess("");

    try {
      if (!form.employeeId.trim()) {
        throw new Error("Employee ID is required.");
      }

      if (!form.firstName.trim()) {
        throw new Error("First name is required.");
      }

      if (!form.fullName.trim()) {
        throw new Error("Full name is required.");
      }

      const payload = {
        ...form,

        experience:
          form.experience === ""
            ? null
            : Number(form.experience),

        salary:
          form.salary === ""
            ? null
            : Number(form.salary),
      };

      const url = editingId
        ? `${API_BASE}/teachers/${editingId}`
        : `${API_BASE}/teachers`;

      const method = editingId ? "PUT" : "POST";

      const response = await fetch(url, {
        method,
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        const text = await response.text();

        throw new Error(
          text || `Server returned ${response.status}`
        );
      }

      const savedTeacher = await response.json();

      if (editingId) {
        setTeachers((previous) =>
          previous.map((teacher) =>
            teacher.id === editingId
              ? savedTeacher
              : teacher
          )
        );

        setSuccess("Teacher updated successfully.");
      } else {
        setTeachers((previous) => [
          ...previous,
          savedTeacher,
        ]);

        setSuccess("Teacher added successfully.");
      }

      setShowModal(false);
      setEditingId(null);
      setForm(emptyTeacher);

    } catch (err) {
      console.error("Save teacher error:", err);

      setError(
        err.message || "Unable to save teacher."
      );
    } finally {
      setSaving(false);
    }
  };

  // =========================================================
  // DELETE
  // =========================================================

  const deleteTeacher = async (teacher) => {
    const confirmed = window.confirm(
      `Are you sure you want to delete ${
        teacher.fullName || "this teacher"
      }?`
    );

    if (!confirmed) {
      return;
    }

    try {
      setError("");
      setSuccess("");

      const response = await fetch(
        `${API_BASE}/teachers/${teacher.id}`,
        {
          method: "DELETE",
        }
      );

      if (!response.ok) {
        throw new Error(
          `Delete failed (${response.status})`
        );
      }

      setTeachers((previous) =>
        previous.filter(
          (item) => item.id !== teacher.id
        )
      );

      setSuccess(
        `${teacher.fullName || "Teacher"} deleted successfully.`
      );

    } catch (err) {
      console.error("Delete teacher error:", err);

      setError(
        err.message ||
          "Unable to delete teacher."
      );
    }
  };

  // =========================================================
  // STATUS
  // =========================================================

  const statusBadge = (status) => {
    if (status === "ACTIVE") {
      return (
        <span className="badge bg-success">
          ACTIVE
        </span>
      );
    }

    if (status === "INACTIVE") {
      return (
        <span className="badge bg-secondary">
          INACTIVE
        </span>
      );
    }

    return (
      <span className="badge bg-dark">
        {status || "-"}
      </span>
    );
  };

  // =========================================================
  // RENDER
  // =========================================================

  return (
    <div
      style={{
        minHeight: "100vh",
        background:
          "linear-gradient(135deg, #eef7ff 0%, #fff4e6 50%, #fcecff 100%)",
      }}
    >
      {/* NAVBAR */}

      <nav
        style={{
          background:
            "linear-gradient(90deg, #0d6efd, #6f42c1)",
          padding: "16px 0",
          boxShadow:
            "0 4px 15px rgba(0,0,0,0.15)",
        }}
      >
        <div className="container d-flex justify-content-between align-items-center">
          <div className="text-white">
            <h4 className="mb-0 fw-bold">
              👩‍🏫 Teachers
            </h4>

            <small>
              KVR Kids Campus Administration
            </small>
          </div>

          <button
            className="btn btn-light fw-bold"
            onClick={() =>
              navigate("/admin/dashboard")
            }
          >
            ← Dashboard
          </button>
        </div>
      </nav>

      {/* CONTENT */}

      <div className="container py-5">

        <div className="d-flex justify-content-between align-items-center mb-4">

          <div>
            <h2 className="fw-bold mb-1">
              👩‍🏫 Teacher Management
            </h2>

            <p className="text-muted mb-0">
              Manage school teaching staff
            </p>
          </div>

          <button
            className="btn btn-primary btn-lg fw-bold"
            onClick={openAddModal}
          >
            + Add Teacher
          </button>

        </div>

        {/* ALERTS */}

        {error && (
          <div className="alert alert-danger">
            ⚠️ {error}
          </div>
        )}

        {success && (
          <div className="alert alert-success">
            ✅ {success}
          </div>
        )}

        {/* TABLE */}

        <div className="card border-0 shadow-sm">
          <div className="card-body">

            {loading ? (
              <div className="text-center py-5">
                <div
                  className="spinner-border text-primary"
                  role="status"
                />

                <div className="mt-3">
                  Loading teachers...
                </div>
              </div>
            ) : teachers.length === 0 ? (
              <div className="text-center py-5">

                <div
                  style={{
                    fontSize: "60px",
                  }}
                >
                  👩‍🏫
                </div>

                <h4 className="fw-bold mt-3">
                  No teachers found
                </h4>

                <p className="text-muted">
                  Add your first teacher.
                </p>

                <button
                  className="btn btn-primary"
                  onClick={openAddModal}
                >
                  + Add Teacher
                </button>

              </div>
            ) : (
              <div className="table-responsive">

                <table className="table table-hover align-middle">

                  <thead className="table-light">
                    <tr>
                      <th>ID</th>
                      <th>Employee ID</th>
                      <th>Teacher</th>
                      <th>Designation</th>
                      <th>Department</th>
                      <th>Phone</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>

                  <tbody>

                    {teachers.map((teacher) => (
                      <tr key={teacher.id}>

                        <td>
                          {teacher.id}
                        </td>

                        <td className="fw-bold">
                          {teacher.employeeId || "-"}
                        </td>

                        <td>
                          <div className="fw-bold">
                            {teacher.fullName ||
                              `${teacher.firstName || ""} ${
                                teacher.lastName || ""
                              }`}
                          </div>

                          <small className="text-muted">
                            {teacher.email || "-"}
                          </small>
                        </td>

                        <td>
                          {teacher.designation || "-"}
                        </td>

                        <td>
                          {teacher.department || "-"}
                        </td>

                        <td>
                          {teacher.phone || "-"}
                        </td>

                        <td>
                          {statusBadge(
                            teacher.status
                          )}
                        </td>

                        <td>
                          <div className="d-flex gap-2">

                            <button
                              className="btn btn-sm btn-outline-primary"
                              onClick={() =>
                                openEditModal(
                                  teacher
                                )
                              }
                            >
                              ✏️ Edit
                            </button>

                            <button
                              className="btn btn-sm btn-outline-danger"
                              onClick={() =>
                                deleteTeacher(
                                  teacher
                                )
                              }
                            >
                              🗑️ Delete
                            </button>

                          </div>
                        </td>

                      </tr>
                    ))}

                  </tbody>

                </table>

              </div>
            )}

          </div>
        </div>

      </div>

      {/* MODAL */}

      {showModal && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            background:
              "rgba(0,0,0,0.55)",
            zIndex: 1050,
            overflowY: "auto",
            padding: "30px",
          }}
        >

          <div
            className="card border-0 shadow-lg mx-auto"
            style={{
              maxWidth: "900px",
              borderRadius: "18px",
            }}
          >

            <div className="card-header bg-primary text-white p-4">

              <div className="d-flex justify-content-between align-items-center">

                <h4 className="mb-0 fw-bold">
                  {editingId
                    ? "✏️ Edit Teacher"
                    : "👩‍🏫 Add Teacher"}
                </h4>

                <button
                  type="button"
                  className="btn-close btn-close-white"
                  onClick={closeModal}
                />

              </div>

            </div>

            <form onSubmit={saveTeacher}>

              <div className="card-body p-4">

                <div className="row g-3">

                  {/* Employee ID */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Employee ID *
                    </label>

                    <input
                      type="text"
                      name="employeeId"
                      className="form-control"
                      value={form.employeeId}
                      onChange={handleChange}
                      required
                    />
                  </div>

                  {/* First Name */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      First Name *
                    </label>

                    <input
                      type="text"
                      name="firstName"
                      className="form-control"
                      value={form.firstName}
                      onChange={handleChange}
                      required
                    />
                  </div>

                  {/* Last Name */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Last Name
                    </label>

                    <input
                      type="text"
                      name="lastName"
                      className="form-control"
                      value={form.lastName}
                      onChange={handleChange}
                    />
                  </div>

                  {/* Full Name */}

                  <div className="col-md-6">
                    <label className="form-label fw-bold">
                      Full Name *
                    </label>

                    <input
                      type="text"
                      name="fullName"
                      className="form-control"
                      value={form.fullName}
                      onChange={handleChange}
                      required
                    />
                  </div>

                  {/* Gender */}

                  <div className="col-md-3">
                    <label className="form-label fw-bold">
                      Gender
                    </label>

                    <select
                      name="gender"
                      className="form-select"
                      value={form.gender}
                      onChange={handleChange}
                    >
                      <option value="">
                        Select
                      </option>

                      <option value="Male">
                        Male
                      </option>

                      <option value="Female">
                        Female
                      </option>
                    </select>
                  </div>

                  {/* Status */}

                  <div className="col-md-3">
                    <label className="form-label fw-bold">
                      Status
                    </label>

                    <select
                      name="status"
                      className="form-select"
                      value={form.status}
                      onChange={handleChange}
                    >
                      <option value="ACTIVE">
                        ACTIVE
                      </option>

                      <option value="INACTIVE">
                        INACTIVE
                      </option>
                    </select>
                  </div>

                  {/* DOB */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Date of Birth
                    </label>

                    <input
                      type="date"
                      name="dateOfBirth"
                      className="form-control"
                      value={form.dateOfBirth}
                      onChange={handleChange}
                    />
                  </div>

                  {/* Qualification */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Qualification
                    </label>

                    <input
                      type="text"
                      name="qualification"
                      className="form-control"
                      placeholder="B.Ed / M.Ed"
                      value={form.qualification}
                      onChange={handleChange}
                    />
                  </div>

                  {/* Specialization */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Specialization
                    </label>

                    <input
                      type="text"
                      name="specialization"
                      className="form-control"
                      value={form.specialization}
                      onChange={handleChange}
                    />
                  </div>

                  {/* Phone */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Phone
                    </label>

                    <input
                      type="text"
                      name="phone"
                      className="form-control"
                      value={form.phone}
                      onChange={handleChange}
                    />
                  </div>

                  {/* Email */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Email
                    </label>

                    <input
                      type="email"
                      name="email"
                      className="form-control"
                      value={form.email}
                      onChange={handleChange}
                    />
                  </div>

                  {/* Joining Date */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Joining Date
                    </label>

                    <input
                      type="date"
                      name="joiningDate"
                      className="form-control"
                      value={form.joiningDate}
                      onChange={handleChange}
                    />
                  </div>

                  {/* Designation */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Designation
                    </label>

                    <input
                      type="text"
                      name="designation"
                      className="form-control"
                      placeholder="Teacher"
                      value={form.designation}
                      onChange={handleChange}
                    />
                  </div>

                  {/* Department */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Department
                    </label>

                    <input
                      type="text"
                      name="department"
                      className="form-control"
                      value={form.department}
                      onChange={handleChange}
                    />
                  </div>

                  {/* Experience */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Experience (Years)
                    </label>

                    <input
                      type="number"
                      name="experience"
                      className="form-control"
                      min="0"
                      value={form.experience}
                      onChange={handleChange}
                    />
                  </div>

                  {/* Salary */}

                  <div className="col-md-4">
                    <label className="form-label fw-bold">
                      Salary
                    </label>

                    <input
                      type="number"
                      name="salary"
                      className="form-control"
                      min="0"
                      value={form.salary}
                      onChange={handleChange}
                    />
                  </div>

                  {/* Address */}

                  <div className="col-12">
                    <label className="form-label fw-bold">
                      Address
                    </label>

                    <textarea
                      name="address"
                      className="form-control"
                      rows="3"
                      value={form.address}
                      onChange={handleChange}
                    />
                  </div>

                </div>

              </div>

              <div className="card-footer bg-white p-4">

                <div className="d-flex justify-content-end gap-2">

                  <button
                    type="button"
                    className="btn btn-secondary"
                    onClick={closeModal}
                    disabled={saving}
                  >
                    Cancel
                  </button>

                  <button
                    type="submit"
                    className="btn btn-primary fw-bold"
                    disabled={saving}
                  >
                    {saving
                      ? "Saving..."
                      : editingId
                      ? "Update Teacher"
                      : "Save Teacher"}
                  </button>

                </div>

              </div>

            </form>

          </div>

        </div>
      )}

    </div>
  );
}

export default Teachers;