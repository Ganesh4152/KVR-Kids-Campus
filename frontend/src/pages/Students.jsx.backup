import { useEffect, useState } from "react";
import { Link, useSearchParams } from "react-router-dom";

function Students() {
  const [searchParams] = useSearchParams();

  const classId = searchParams.get("classId");
  const className = searchParams.get("className");
  const section = searchParams.get("section");

  const [students, setStudents] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    loadStudents();
  }, [classId]);

  const loadStudents = async () => {
    setLoading(true);
    setError("");

    try {
      let url = "http://localhost:8080/api/students";

      if (classId) {
        url = `http://localhost:8080/api/students/class/${classId}`;
      }

      const response = await fetch(url);

      if (!response.ok) {
        throw new Error(`Server returned ${response.status}`);
      }

      const data = await response.json();

      setStudents(Array.isArray(data) ? data : []);
    } catch (err) {
      console.error("Student API error:", err);
      setError(
        "Unable to load students. Please make sure the Spring Boot backend is running."
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <div
      style={{
        minHeight: "100vh",
        background:
          "linear-gradient(135deg, #eef7ff 0%, #fff4e6 50%, #fcecff 100%)",
      }}
    >
      {/* Navbar */}
      <nav
        style={{
          background: "linear-gradient(90deg, #0d6efd, #6f42c1)",
          padding: "16px 0",
          boxShadow: "0 4px 15px rgba(0,0,0,0.15)",
        }}
      >
        <div
          className="container d-flex justify-content-between align-items-center"
        >
          <div
            style={{
              color: "white",
              fontSize: "24px",
              fontWeight: "700",
            }}
          >
            🏫 KVR Kids Campus
          </div>

          <Link
            to="/admin/classes"
            className="btn btn-light fw-bold"
          >
            ← Back to Classes
          </Link>
        </div>
      </nav>

      {/* Main Content */}
      <div className="container py-5">

        {/* Header */}
        <div
          className="d-flex justify-content-between align-items-center mb-4"
          style={{
            flexWrap: "wrap",
            gap: "15px",
          }}
        >
          <div>
            <h1
              style={{
                color: "#0d6efd",
                fontWeight: "800",
                marginBottom: "8px",
              }}
            >
              👨‍🎓 Students
            </h1>

            <p
              style={{
                fontSize: "18px",
                color: "#555",
                marginBottom: 0,
              }}
            >
              {className
                ? `Students in ${className}`
                : "Manage school students"}
            </p>
          </div>

          <div
            style={{
              background: "white",
              padding: "12px 20px",
              borderRadius: "30px",
              boxShadow: "0 3px 12px rgba(0,0,0,0.1)",
              fontWeight: "700",
              color: "#0d6efd",
            }}
          >
            👥 {students.length} Students
          </div>
        </div>

        {/* Class Information */}
        {classId && (
          <div
            className="card border-0 shadow-sm mb-4"
            style={{
              borderRadius: "15px",
              overflow: "hidden",
            }}
          >
            <div
              style={{
                background:
                  "linear-gradient(90deg, #0d6efd, #6610f2)",
                color: "white",
                padding: "18px 22px",
              }}
            >
              <h5 className="mb-1 fw-bold">
                🎓 {className || "Selected Class"}
              </h5>

              <div>
                Class ID: {classId}
                {section && section !== "-" && (
                  <> &nbsp; | &nbsp; Section: {section}</>
                )}
              </div>
            </div>
          </div>
        )}

        {/* Error */}
        {error && (
          <div className="alert alert-danger shadow-sm">
            <strong>⚠️ Error:</strong> {error}

            <div className="mt-2">
              <button
                className="btn btn-danger btn-sm"
                onClick={loadStudents}
              >
                Try Again
              </button>
            </div>
          </div>
        )}

        {/* Loading */}
        {loading && (
          <div
            className="card border-0 shadow-sm text-center p-5"
            style={{ borderRadius: "18px" }}
          >
            <div
              className="spinner-border text-primary mb-3"
              role="status"
            />

            <h5>Loading students...</h5>

            <p className="text-muted mb-0">
              Please wait while we fetch student information.
            </p>
          </div>
        )}

        {/* No Students */}
        {!loading && !error && students.length === 0 && (
          <div
            className="card border-0 shadow-sm text-center p-5"
            style={{
              borderRadius: "18px",
              background: "white",
            }}
          >
            <div style={{ fontSize: "60px" }}>
              🎒
            </div>

            <h3 className="fw-bold mt-3">
              No Students Found
            </h3>

            <p className="text-muted">
              There are no students assigned to this class yet.
            </p>
          </div>
        )}

        {/* Student List */}
        {!loading && !error && students.length > 0 && (
          <div
            className="card border-0 shadow-sm"
            style={{
              borderRadius: "18px",
              overflow: "hidden",
            }}
          >
            <div
              className="card-header"
              style={{
                background: "#ffffff",
                padding: "20px",
              }}
            >
              <h4 className="fw-bold mb-0">
                📋 Student List
              </h4>
            </div>

            <div className="table-responsive">
              <table className="table table-hover align-middle mb-0">

                <thead
                  style={{
                    background: "#dbeafe",
                  }}
                >
                  <tr>
                    <th>#</th>
                    <th>Admission No</th>
                    <th>Student Name</th>
                    <th>Roll No</th>
                    <th>Gender</th>
                    <th>Academic Year</th>
                    <th>Status</th>
                  </tr>
                </thead>

                <tbody>
                  {students.map((student, index) => (
                    <tr key={student.id || index}>

                      <td className="fw-bold">
                        {index + 1}
                      </td>

                      <td>
                        <span
                          className="badge"
                          style={{
                            background: "#6f42c1",
                            fontSize: "13px",
                          }}
                        >
                          {student.admissionNo || "-"}
                        </span>
                      </td>

                      <td>
                        <div className="fw-bold text-primary">
                          🎓 {student.fullName || "-"}
                        </div>
                      </td>

                      <td>
                        {student.rollNo || "-"}
                      </td>

                      <td>
                        {student.gender || "-"}
                      </td>

                      <td>
                        {student.academicYear || "-"}
                      </td>

                      <td>
                        <span
                          className={`badge ${
                            student.status === "ACTIVE"
                              ? "bg-success"
                              : "bg-secondary"
                          }`}
                        >
                          {student.status || "-"}
                        </span>
                      </td>

                    </tr>
                  ))}
                </tbody>

              </table>
            </div>
          </div>
        )}

      </div>
    </div>
  );
}

export default Students;