import { useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { FaGraduationCap, FaArrowLeft, FaUserGraduate } from "react-icons/fa";

function StudentLogin() {
  const navigate = useNavigate();

  const [studentId, setStudentId] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");

  const handleLogin = async (e) => {
    e.preventDefault();

    setError("");

    if (!studentId || !password) {
      setError("Please enter Student ID and Password.");
      return;
    }

    try {
      const response = await fetch(
        "http://localhost:8080/api/auth/student-login",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            studentId,
            password,
          }),
        }
      );

      if (!response.ok) {
        throw new Error("Invalid Student ID or Password");
      }

      const data = await response.json();

      localStorage.setItem("student", JSON.stringify(data));

      navigate("/student/dashboard");
    } catch (err) {
      setError(err.message);
    }
  };

  return (
    <div
      style={{
        minHeight: "100vh",
        background:
          "linear-gradient(135deg, #e0f7ff 0%, #fff4d6 45%, #f8e7ff 100%)",
        padding: "40px 20px",
        position: "relative",
        overflow: "hidden",
      }}
    >

      {/* Decorative circles */}

      <div
        style={{
          position: "absolute",
          width: "220px",
          height: "220px",
          borderRadius: "50%",
          background: "rgba(13, 110, 253, 0.12)",
          top: "-70px",
          left: "-70px",
        }}
      />

      <div
        style={{
          position: "absolute",
          width: "280px",
          height: "280px",
          borderRadius: "50%",
          background: "rgba(255, 193, 7, 0.15)",
          bottom: "-100px",
          right: "-80px",
        }}
      />

      <div className="container">

        {/* Back to Home */}

        <div className="mb-4">
          <Link
            to="/"
            className="btn btn-light shadow-sm"
            style={{
              borderRadius: "25px",
              fontWeight: "600",
              padding: "10px 18px",
            }}
          >
            <FaArrowLeft className="me-2" />
            Back to Home
          </Link>
        </div>

        <div className="row justify-content-center">

          <div className="col-md-7 col-lg-5">

            <div
              className="card border-0 shadow-lg"
              style={{
                borderRadius: "25px",
                overflow: "hidden",
              }}
            >

              {/* Header */}

              <div
                style={{
                  background:
                    "linear-gradient(135deg, #0d6efd, #6f42c1)",
                  padding: "30px 20px",
                  textAlign: "center",
                  color: "white",
                }}
              >
                <div
                  style={{
                    width: "75px",
                    height: "75px",
                    borderRadius: "50%",
                    background: "white",
                    margin: "0 auto 15px",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                  }}
                >
                  <FaGraduationCap
                    size={40}
                    style={{ color: "#6f42c1" }}
                  />
                </div>

                <h2 className="fw-bold mb-1">
                  Student Login
                </h2>

                <p className="mb-0">
                  KVR Kids Campus
                </p>

                <small>
                  Indian EM School - Vayalpadu
                </small>
              </div>

              {/* Login Form */}

              <div className="card-body p-4 p-md-5">

                {error && (
                  <div
                    className="alert alert-danger"
                    style={{
                      borderRadius: "12px",
                      fontWeight: "500",
                    }}
                  >
                    {error}
                  </div>
                )}

                <form onSubmit={handleLogin}>

                  {/* Student ID */}

                  <div className="mb-4">

                    <label className="form-label fw-semibold">
                      <FaUserGraduate className="me-2 text-primary" />
                      Student ID
                    </label>

                    <input
                      type="text"
                      className="form-control form-control-lg"
                      placeholder="Example: KVR2026001"
                      value={studentId}
                      onChange={(e) => setStudentId(e.target.value)}
                      style={{
                        borderRadius: "12px",
                        padding: "12px 15px",
                      }}
                    />

                  </div>

                  {/* Password */}

                  <div className="mb-4">

                    <label className="form-label fw-semibold">
                      Password
                    </label>

                    <input
                      type="password"
                      className="form-control form-control-lg"
                      placeholder="Enter password"
                      value={password}
                      onChange={(e) => setPassword(e.target.value)}
                      style={{
                        borderRadius: "12px",
                        padding: "12px 15px",
                      }}
                    />

                  </div>

                  {/* Login Button */}

                  <button
                    type="submit"
                    className="btn btn-lg w-100 text-white fw-bold"
                    style={{
                      borderRadius: "12px",
                      padding: "12px",
                      background:
                        "linear-gradient(135deg, #0d6efd, #6f42c1)",
                      border: "none",
                    }}
                  >
                    <FaGraduationCap className="me-2" />
                    Student Login
                  </button>

                </form>

                {/* New Student */}

                <div
                  className="text-center mt-4 p-3"
                  style={{
                    background: "#f8f9fa",
                    borderRadius: "15px",
                  }}
                >

                  <p className="mb-2 fw-semibold">
                    New student?
                  </p>

                  <Link
                    to="/admissions"
                    className="btn btn-outline-success"
                    style={{
                      borderRadius: "20px",
                      fontWeight: "600",
                    }}
                  >
                    Apply for Admission
                  </Link>

                </div>

              </div>

            </div>

            {/* Footer */}

            <div className="text-center mt-4 text-muted">
              <small>
                © 2026 KVR Kids Campus • Student Portal
              </small>
            </div>

          </div>

        </div>

      </div>
    </div>
  );
}

export default StudentLogin;